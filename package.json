{
  "name": "lead-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Lead Tracker: event leads, follow-ups, deals, quotes, sequences and team reporting, with single sign-on and role-based access. Self-hosted.",
  "scripts": {
    "dev": "next dev",
    "build": "next build $( [ -n \"$RENDER\" ] && echo --webpack )",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "worker": "tsx scripts/worker.ts",
    "db:demo": "tsx scripts/demo.ts",
    "practice:reset": "tsx scripts/practice-reset.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-s3": "^3.1145.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "jsqr": "^1.4.0",
    "mammoth": "^1.13.0",
    "next": "^16.3.8",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^8.0.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.296",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "read-excel-file": "^9.3.10",
    "swr": "^2.5.1",
    "unpdf": "^1.8.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
